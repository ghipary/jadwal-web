{
  "name": "jadwal-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "esbuild scripts/test.ts --bundle --platform=node --format=esm --jsx=automatic --outfile=temp/test.mjs --log-level=warning && node temp/test.mjs",
    "test:render": "esbuild scripts/test-render.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=temp/test-render.cjs --log-level=warning && node temp/test-render.cjs",
    "test:form": "esbuild scripts/test-form-hari.tsx --bundle --platform=node --format=esm --jsx=automatic --outfile=temp/form.mjs --log-level=warning && node temp/form.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
